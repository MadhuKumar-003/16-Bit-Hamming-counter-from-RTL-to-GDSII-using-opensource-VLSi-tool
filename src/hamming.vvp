#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x650dd9a06170 .scope module, "tb_hamming" "tb_hamming" 2 3;
 .timescale -9 -12;
v0x650dd9a2f3f0_0 .var "in", 15 0;
v0x650dd9a2f4b0_0 .net "out", 4 0, v0x650dd9a2f2d0_0;  1 drivers
S_0x650dd9a09150 .scope module, "uut" "hamming_counter" 2 12, 3 1 0, S_0x650dd9a06170;
 .timescale 0 0;
    .port_info 0 /INPUT 16 "in";
    .port_info 1 /OUTPUT 5 "out";
v0x650dd9a19300_0 .var/i "i", 31 0;
v0x650dd9a2f1f0_0 .net "in", 15 0, v0x650dd9a2f3f0_0;  1 drivers
v0x650dd9a2f2d0_0 .var "out", 4 0;
E_0x650dd99dfa70 .event anyedge, v0x650dd9a2f2d0_0, v0x650dd9a2f1f0_0;
    .scope S_0x650dd9a09150;
T_0 ;
    %wait E_0x650dd99dfa70;
    %pushi/vec4 0, 0, 5;
    %store/vec4 v0x650dd9a2f2d0_0, 0, 5;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x650dd9a19300_0, 0, 32;
T_0.0 ;
    %load/vec4 v0x650dd9a19300_0;
    %cmpi/s 16, 0, 32;
    %jmp/0xz T_0.1, 5;
    %load/vec4 v0x650dd9a2f2d0_0;
    %load/vec4 v0x650dd9a2f1f0_0;
    %load/vec4 v0x650dd9a19300_0;
    %part/s 1;
    %pad/u 5;
    %add;
    %store/vec4 v0x650dd9a2f2d0_0, 0, 5;
    %load/vec4 v0x650dd9a19300_0;
    %addi 1, 0, 32;
    %store/vec4 v0x650dd9a19300_0, 0, 32;
    %jmp T_0.0;
T_0.1 ;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x650dd9a06170;
T_1 ;
    %vpi_call 2 19 "$dumpfile", "hamming_waveform.vcd" {0 0 0};
    %vpi_call 2 20 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x650dd9a06170 {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x650dd9a06170;
T_2 ;
    %vpi_call 2 25 "$display", "-------------------------------------------" {0 0 0};
    %vpi_call 2 26 "$display", "Starting 16-Bit Hamming Counter Test..." {0 0 0};
    %pushi/vec4 0, 0, 16;
    %store/vec4 v0x650dd9a2f3f0_0, 0, 16;
    %delay 10000, 0;
    %vpi_call 2 31 "$display", "Input: %b | Count: %d", v0x650dd9a2f3f0_0, v0x650dd9a2f4b0_0 {0 0 0};
    %pushi/vec4 1, 0, 16;
    %store/vec4 v0x650dd9a2f3f0_0, 0, 16;
    %delay 10000, 0;
    %vpi_call 2 36 "$display", "Input: %b | Count: %d", v0x650dd9a2f3f0_0, v0x650dd9a2f4b0_0 {0 0 0};
    %pushi/vec4 43690, 0, 16;
    %store/vec4 v0x650dd9a2f3f0_0, 0, 16;
    %delay 10000, 0;
    %vpi_call 2 41 "$display", "Input: %b | Count: %d", v0x650dd9a2f3f0_0, v0x650dd9a2f4b0_0 {0 0 0};
    %pushi/vec4 7204, 0, 16;
    %store/vec4 v0x650dd9a2f3f0_0, 0, 16;
    %delay 10000, 0;
    %vpi_call 2 46 "$display", "Input: %b | Count: %d", v0x650dd9a2f3f0_0, v0x650dd9a2f4b0_0 {0 0 0};
    %pushi/vec4 65535, 0, 16;
    %store/vec4 v0x650dd9a2f3f0_0, 0, 16;
    %delay 10000, 0;
    %vpi_call 2 51 "$display", "Input: %b | Count: %d", v0x650dd9a2f3f0_0, v0x650dd9a2f4b0_0 {0 0 0};
    %vpi_call 2 53 "$display", "Simulation Complete." {0 0 0};
    %vpi_call 2 54 "$display", "-------------------------------------------" {0 0 0};
    %vpi_call 2 55 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "hammingtb.v";
    "hamming.v";
